# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
dist/
build/

# Secrets — never commit credentials
.env
.env.*
*.key

# Generated media / runs (large, reproducible; examples regenerate from
# their committed .prompt.txt — never commit video or audio media)
runs/
exports/
*.mp4
*.mov
*.webm
*.m4a
page@*.webm

# Allow small committed demo assets explicitly
!assets/*.gif

# OS
.DS_Store
